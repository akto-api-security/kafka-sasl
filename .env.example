# Kafka Broker Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-producer-api

# SASL Authentication
KAFKA_SASL_ENABLED=true
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=kafka-client
KAFKA_SASL_PASSWORD=your-password-here

# SSL/TLS Configuration
KAFKA_SSL_ENABLED=false

# Producer Configuration
KAFKA_PRODUCER_TIMEOUT=30000
KAFKA_PRODUCER_RETRY_ATTEMPTS=5
KAFKA_PRODUCER_RETRY_DELAY=300

# Topic Configuration
KAFKA_DEFAULT_TOPIC=test-topic

# API Server Configuration
PORT=3000
HOST=0.0.0.0

# Logging
LOG_LEVEL=info
